<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="Desktop.RoomWindow"
        Title="RoomWindow">


  <StackPanel>


    <StackPanel Orientation="Horizontal">
      <Grid RowDefinitions="35,35,35,35,35,35,35" ColumnDefinitions="*">
        <TextBlock Name="memberstext" Grid.Column="0">members</TextBlock>
        <Button  Grid.Row="4" Width="125" HorizontalContentAlignment="Center">Add user</Button>
        <Button Grid.Row="5" Width="125" HorizontalContentAlignment="Center">Change Topic</Button>
        <Button Grid.Row="6" Width="125" HorizontalContentAlignment="Center">Leave Chatroom</Button>
      </Grid>
      <TextBlock Name="Messages">/////</TextBlock>
    </StackPanel>

    <Grid RowDefinitions="100" ColumnDefinitions="*,Auto">
      <TextBox Name="inputtext"></TextBox>
      <Button Grid.Column="1" Height="100" VerticalContentAlignment="Center">Send</Button>
    </Grid>


  </StackPanel>
</Window>
